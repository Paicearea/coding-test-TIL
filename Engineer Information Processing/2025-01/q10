public class Main {
  public static void main(String[] args) {
    // 오버로딩된 calc(String)을 호출 (인자로 "5" 전달)
    System.out.println(calc("5"));
  }

  // calc(int): 피보나치처럼 동작 (F(n) = F(n-1) + F(n-2), F(0)=0, F(1)=1)
  static int calc(int value) {
    if (value <= 1) return value;
    return calc(value - 1) + calc(value - 2);
  }

  // calc(String): 문자열을 정수로 바꾼 뒤,
  //               calc(value-1) + calc(value-3)을 호출
  //               여기서 호출되는 calc는 파라미터 타입이 int이므로 calc(int) 오버로드가 선택됨
  static int calc(String str) {
    int value = Integer.valueOf(str); // "5" -> 5
    if (value <= 1) return value;
    return calc(value - 1) + calc(value - 3); // => calc(4) + calc(2), 둘 다 calc(int)
  }
}

// F(0)=0, F(1)=1
// F(2)=F(1)+F(0)=1
// F(3)=F(2)+F(1)=2
// F(4)=F(3)+F(2)=3
// calc(4) + calc(2) = 3 + 1 = 4

// 출력: 4