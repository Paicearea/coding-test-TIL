public class Main {
    public static void main(String[] args) {
        new Child();                     // (1) Child 객체 생성
        System.out.println(Parent.total);// (6) 누적된 total 출력
    }
}

class Parent {
    static int total = 0;                // 클래스 변수
    int v = 1;                           // Parent의 인스턴스 필드(초깃값 1)

    public Parent() {                    // (3) super쪽 생성자 본문
        total += (++v);                  // Parent.v: 1→2, total: 0→2
        show();                          // (4) 동적 바인딩으로 Child.show() 호출
    }

    public void show() {                 // (부모 버전: 호출되지 않음)
        total += total;
    }
}

class Child extends Parent {
    int v = 10;                          // Child의 인스턴스 필드(Parent.v와 별개, 숨김)

    public Child() {
        // 객체 생성 시 실제 실행 순서:
        // (2) Parent의 인스턴스 초기화/생성자 → (3)(4) 수행 후
        //     Child의 필드 초기화 v=10 → 아래 본문 실행
        v += 2;                          // Child.v: 10→12
        total += v++;                    // total: 2에서 +12 → 14? (※ 아래 정정) 
        show();                          // Child.show() 호출
    }

    @Override
    public void show() {
        total += total * 2;              // total = total + (total*2) = total*3
    }
}

// total = 18 + 18*2 = 54
// 예상 출력: 54