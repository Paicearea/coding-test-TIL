#include <stdio.h>

// 전역 변수 선언
char Data[5] = {'B', 'A', 'D', 'E'}; // 문자 배열 (마지막 원소는 비어 있음)
char c; // 새로 삽입할 문자 저장용

int main() {
    int i, temp, temp2;

    c = 'C'; // 새로 삽입할 문자
    // Data[3] = 'E', Data[1] = 'A' → 'E' - 'A' = 69 - 65 = 4
    printf("%d\n", Data[3] - Data[1]); // 첫 번째 출력: 4

    // ① 'C'가 들어갈 위치를 찾기 위한 루프
    // Data 배열을 순회하며 Data[i]가 'C'보다 큰 첫 위치를 찾는다.
    for (i = 0; i < 5; ++i) {
        if (Data[i] > c) // 'C'보다 큰 문자가 나오면 중단
            break;
    }
    // 반복이 멈춘 i는 'C'가 삽입될 위치 (여기서는 i = 2, 'D'가 'C'보다 크기 때문)

    // ② i 위치에 'C'를 삽입하기 위한 준비
    temp = Data[i]; // 현재 위치의 값을 임시 저장 ('D')
    Data[i] = c;    // 해당 위치에 'C'를 삽입
    i++;            // 다음 인덱스로 이동 (이후 문자들을 한 칸씩 뒤로 밀기 위함)

    // ③ 남은 문자들을 한 칸씩 뒤로 밀면서 temp를 옮겨 담음
    for (; i < 5; ++i) {
        temp2 = Data[i]; // 현재 위치의 값을 temp2에 백업
        Data[i] = temp;  // 이전 temp 값을 현재 위치에 복사
        temp = temp2;    // temp를 다음 값으로 갱신
    }
    // 결과적으로 'C'가 올바른 위치(정렬 순서)에 삽입되고,
    // 뒤의 문자들이 한 칸씩 뒤로 밀림.
    // 최종 배열 상태: {'B', 'A', 'C', 'D', 'E'}

    // ④ 배열의 최종 상태 출력
    for (i = 0; i < 5; i++) {
        printf("%c", Data[i]);
    }
    // 출력 결과: BACDE

    return 0;
}

// 예상 출력 윗줄: 4
// 예상 출력 아랫줄: BACDE