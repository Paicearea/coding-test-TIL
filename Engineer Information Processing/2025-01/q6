public class Main {

    public static void main(String[] args) {
        int[] data = {3, 5, 8, 12, 17};
        System.out.println(func(data, 0, data.length - 1)); // 전체 구간 호출
    }

    static int func(int[] a, int st, int end) {
        // 구간의 길이가 1 이하(st >= end)이면 더할 것이 없음
        if (st >= end) return 0;

        // 현재 구간의 가운데 인덱스
        int mid = (st + end) / 2;

        // 가운데 값 a[mid]에,
        // 왼쪽 구간(st~mid)과 오른쪽 구간(mid+1~end) 중
        // 더 큰 쪽의 재귀 결과를 더해 반환
        return a[mid] + Math.max(
                func(a, st, mid),
                func(a, mid + 1, end)
        );
    }
}

// 예상 출력: 20