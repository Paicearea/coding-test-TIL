# set(집합) 자료형 생성 — 중괄호 { }로 정의
a = {'일본', '중국', '한국'}
# 현재 a = {'일본', '중국', '한국'}

# '베트남' 추가
a.add('베트남')
# a = {'일본', '중국', '한국', '베트남'}

# '중국' 추가 (하지만 이미 존재하므로 중복 저장 ❌)
a.add('중국')
# a = {'일본', '중국', '한국', '베트남'}  ← 변화 없음

# '일본' 제거
a.remove('일본')
# a = {'중국', '한국', '베트남'}

# 여러 개의 원소를 한 번에 추가할 때는 update() 사용
# 리스트 ['홍콩','한국','태국']의 원소들이 각각 추가됨
# 단, '한국'은 이미 존재하므로 중복 추가되지 않음
a.update(['홍콩', '한국', '태국'])
# a = {'중국', '한국', '베트남', '홍콩', '태국'}

# set은 순서가 없으므로 출력 순서는 실행할 때마다 달라질 수 있음
print(a)
