# 변수 a에 100을 저장
a = 100

# result 변수 초기값을 0으로 설정
result = 0

# range(1, 3)은 1부터 2까지 반복됨 → i = 1, i = 2
for i in range(1, 3):
    
    # a를 i만큼 오른쪽으로 비트 시프트(>>) 함
    # 즉, 2의 i제곱으로 나눈 정수 결과를 구함
    # i = 1일 때: 100 >> 1 → 100 / 2 = 50
    # i = 2일 때: 100 >> 2 → 100 / 4 = 25
    result = a >> i

    # 위에서 얻은 결과에 1을 더함
    # i = 1일 때: result = 50 + 1 = 51
    # i = 2일 때: result = 25 + 1 = 26
    result = result + 1

# 반복문이 모두 끝나면 result에는 마지막 값 26이 저장됨
print(result)  # 최종 출력: 26
