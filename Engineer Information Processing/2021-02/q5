public class ovr1 {
    public static void main(String[] args){
        ovr1 a1 = new ovr1();   // a1은 부모 클래스(oVr1) 타입/인스턴스
        ovr2 a2 = new ovr2();   // a2는 자식 클래스(ovr2) 인스턴스

        // a1.sun(3,2)  → ovr1의 sun 실행 (오버라이딩 없음)  → 3 + 2 = 5
        // a2.sun(3,2)  → ovr2에서 오버라이딩된 sun 실행
        //                 내부에서 (x - y) + super.sun(x,y)
        //               = (3 - 2) + (부모 ovr1의 sun(3,2)=5)
        //               = 1 + 5 = 6
        // 두 값을 더함: 5 + 6 = 11
        System.out.println(a1.sun(3,2) + a2.sun(3,2)); // 최종 출력: 11
    }

    // 부모(기본) 구현: 두 수의 합을 반환
    int sun(int x, int y){
        return x + y; // 예) 3 + 2 = 5
    }
}

// ovr2는 ovr1을 상속받아 sun을 '오버라이딩'함
class ovr2 extends ovr1 {

    // 오버라이딩된 메서드: (x - y) + super.sun(x,y)
    // super.sun(x,y)는 부모(ovr1)의 구현을 직접 호출
    int sun(int x, int y){
        // (3 - 2) + super.sun(3,2)
        //  = 1     + 5
        //  = 6
        return x - y + super.sun(x,y);
    }
}
