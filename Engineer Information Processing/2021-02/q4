#include <stdio.h>

int main() {

    int ary[3];    // 정수 3개를 저장할 배열 선언 (ary[0], ary[1], ary[2])
    int s = 0;     // 합계를 저장할 변수 s

    // *(ary + 0) = 1;
    // → ary[0] = 1; 과 같은 의미 (배열의 첫 번째 요소에 1 저장)
    *(ary + 0) = 1;         // ary[0] = 1

    // ary[1] = *(ary + 0) + 2;
    // → ary[1] = ary[0] + 2 = 1 + 2 = 3
    ary[1] = *(ary + 0) + 2; // ary[1] = 3

    // ary[2] = *ary + 3;
    // → *ary는 ary[0]과 같음 → 1 + 3 = 4
    ary[2] = *ary + 3;       // ary[2] = 4

    /*
       배열의 현재 상태:
       ary[0] = 1
       ary[1] = 3
       ary[2] = 4
    */

    // for문을 이용해 배열 요소 합계를 계산
    for (int i = 0; i < 3; i++) {
        s = s + ary[i];      // s에 ary[i] 값을 계속 더함
        /*
           i=0 → s = 0 + 1 = 1
           i=1 → s = 1 + 3 = 4
           i=2 → s = 4 + 4 = 8
        */
    }

    // 최종 s = 8
    printf("%d", s);         // 결과 출력: 8

    return 0;
}
