#include <stdio.h>

void main() {
    char *p = "KOREA";   // 문자열 상수 "KOREA"의 첫 글자 주소를 p가 가리킴

    // 1️⃣ p는 "KOREA"의 시작 주소를 가리키므로, printf("%s", p)는 문자열 전체 출력
    printf("%s\n", p);      // 출력: KOREA

    // 2️⃣ p+3은 "KOREA"에서 3칸 뒤의 주소 → 'E'의 위치를 가리킴
    // 즉, p+3은 "EA"라는 문자열의 시작 주소
    printf("%s\n", p + 3);  // 출력: EA

    // 3️⃣ *p → p가 가리키는 첫 번째 문자 → 'K'
    printf("%c\n", *p);     // 출력: K

    // 4️⃣ *(p + 3) → p에서 3칸 뒤의 문자 → 'E'
    printf("%c\n", *(p + 3));  // 출력: E

    // 5️⃣ *p + 2 → 문자 'K'의 아스키 코드(75)에 2를 더한 값 → 77 = 'M'
    // 즉, 문자 연산 결과는 'M'
    printf("%c\n", *p + 2);    // 출력: M
}
