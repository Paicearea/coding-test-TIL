public class good {
    public static void main(String[] args) {
        int[] a = new int[8];  // 8비트(1바이트) 저장용 배열 생성 → 초기값은 모두 0
        int i = 0;
        int n = 10;            // 10진수 10을 2진수로 변환할 예정

        // 🔹 while 조건: i < 8  → 8자리(비트) 모두 처리하기 위해 8번 반복
        //    n이 0이 되더라도 나머지 비트는 0으로 채워야 하므로, 8비트 고정 표현을 위해 i 기준으로 반복
        while (i < 8) {

            // 🔹 n & 1 → 현재 n의 마지막 비트를 구함
            //    (n % 2 와 동일한 결과)
            //    짝수 → 0, 홀수 → 1
            // 예)
            // n=10 (1010) → n&1=0
            // n=5  (0101) → n&1=1
            a[i++] = n & 1;

            // 🔹 n /= 2 → n을 2로 나누어 한 비트를 오른쪽으로 이동
            // 즉, 다음 루프에서 다음 비트(상위 비트)를 계산함
            n /= 2;
        }

        // 🔹 배열에는 a[0]부터 a[7]까지 각 비트가 ‘역순’으로 저장됨
        //    (맨 처음 계산한 게 가장 낮은 비트, 마지막이 가장 높은 비트)
        //    따라서 거꾸로 출력해야 정상적인 2진수 형태가 나옴
        for (i = 7; i >= 0; i--) {
            System.out.print(a[i]);
        }

        /*
           🔍 실행 과정 요약 (n = 10일 때)

           초기 n = 10 (이진수: 00001010)
           i=0 → a[0] = 10 & 1 = 0, n=5
           i=1 → a[1] = 5 & 1 = 1, n=2
           i=2 → a[2] = 2 & 1 = 0, n=1
           i=3 → a[3] = 1 & 1 = 1, n=0
           i=4~7 → n=0이므로 a[4]~a[7]=0

           배열 상태 (저장 순서: 역순)
           a = [0,1,0,1,0,0,0,0]

           역순으로 출력하면 → 00001010
        */

        // ✅ 최종 출력 결과:
        // 00001010
    }
}
