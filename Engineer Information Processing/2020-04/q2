public class good {
    public static void main(String[] args) {
        // (1) 3행 (2) 5열 배열 생성
        int[][] a = new int[3][5];

        // i는 행(0~2), j는 열(0~4)
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 5; j++) {

                // 공식: a[i][j] = j*3 + (i+1)
                // j는 열 인덱스(0~4), i는 행 인덱스(0~2)
                // 각 열마다 값이 3씩 증가하고, 행마다 시작값이 달라짐

                /*
                  예시 계산 과정
                  j=0일 때: i=0→1, i=1→2, i=2→3
                  j=1일 때: i=0→4, i=1→5, i=2→6
                  j=2일 때: i=0→7, i=1→8, i=2→9
                  j=3일 때: i=0→10, i=1→11, i=2→12
                  j=4일 때: i=0→13, i=1→14, i=2→15
                */

                a[i][j] = j * 3 + (i + 1);

                // 결과값 출력
                System.out.print(a[i][j] + " ");
            }
            // 한 행(가로줄)이 끝나면 줄바꿈
            System.out.println();
        }
    }
}
