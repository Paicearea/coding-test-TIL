class parent {
    public int compute(int num) {
        if (num <= 1) return num;   // 0 또는 1이면 그대로 반환
        return compute(num - 1) + compute(num - 2);
    }
}

class Child extends parent {
    public int compute(int num) {
        if (num <= 1) return num;   // 0 이하일 경우 그대로 반환
        // 부모와 달리 num-3 사용 → f(n) = f(n-1) + f(n-3)
        return compute(num - 1) + compute(num - 3);
    }
}

class good {
    public static void main(String[] args) {
        parent obj = new Child();   // 부모 타입, 실제 객체는 Child
        System.out.println(obj.compute(4));  // Child의 compute(4) 호출

        /*
           🔍 실행 과정:
           compute(4)
            → compute(3) + compute(1)
            → (compute(2) + compute(0)) + 1
            → ((compute(1) + compute(-1)) + 0) + 1
            → ((1 + (-1)) + 0) + 1
            → (0 + 0) + 1
            → 1

           ✅ 최종 출력값: 1
        */
    }
}
