#include <stdio.h>

int main() {
    // 3×3 2차원 배열 초기화
    int arr[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    /*
      arr[0] → {1, 2, 3} 의 시작 주소
      arr[1] → {4, 5, 6} 의 시작 주소
      arr[2] → {7, 8, 9} 의 시작 주소
    */

    // 포인터 배열 parr: arr[1], arr[2]의 시작 주소를 저장
    int* parr[2] = {arr[1], arr[2]};
    /*
      parr[0] → arr[1] → {4, 5, 6}
      parr[1] → arr[2] → {7, 8, 9}
    */

    // 식: parr[1][1] + *(parr[1] + 2) + **parr
    // 하나씩 해석하자 👇

    // parr[1][1]
    // = *(parr[1] + 1)
    // = *(arr[2] + 1)
    // = arr[2][1] = 8

    // *(parr[1] + 2)
    // = *(arr[2] + 2)
    // = arr[2][2] = 9

    // **parr
    // = **(parr + 0)
    // = *parr[0]
    // = *arr[1]
    // = arr[1][0] = 4

    // 합 = 8 + 9 + 4 = 21
    printf("%d", parr[1][1] + *(parr[1]+2) + **parr);
    
    return 0;
}
