#include <stdio.h>

int main(void) {

    int n;   // 검사할 수 (6~30)
    int k;   // n의 절반 (약수 탐색 한계)
    int s;   // 약수의 합
    int el = 0; // 완전수 개수 카운트

    // ✅ 1️⃣ 6부터 30까지 반복
    for (n = 6; n <= 30; n++) {

        s = 0;      // 약수 합 초기화
        k = n / 2;  // 약수는 자기 절반까지만 존재함

        // ✅ 2️⃣ 약수 합 구하기
        for (int j = 1; j <= k; j++) {
            if (n % j == 0) {  // j가 n의 약수라면
                s = s + j;     // 약수 누적 합
            }
        }

        // ✅ 3️⃣ 완전수 판단
        // 완전수(perfect number): 자신을 제외한 약수들의 합 = 자기 자신
        if (s == n) {
            el++; // 완전수 개수 1 증가
        }
    }

    // ✅ 4️⃣ 최종 결과 출력
    printf("%d", el);

    /*
    ==============================
    🔍 완전수 판정 과정 (6~30)
    ==============================

    6 → 약수: 1, 2, 3 → 합 6 = 자기 자신 ✅ 완전수
    7 → 약수: 1 → 합 1 ❌
    8 → 1, 2, 4 → 합 7 ❌
    9 → 1, 3 → 합 4 ❌
    10 → 1, 2, 5 → 합 8 ❌
    11 → 1 → 합 1 ❌
    12 → 1, 2, 3, 4, 6 → 합 16 ❌
    13 → 1 → 합 1 ❌
    14 → 1, 2, 7 → 합 10 ❌
    15 → 1, 3, 5 → 합 9 ❌
    16 → 1, 2, 4, 8 → 합 15 ❌
    17 → 1 → 합 1 ❌
    18 → 1, 2, 3, 6, 9 → 합 21 ❌
    19 → 1 → 합 1 ❌
    20 → 1, 2, 4, 5, 10 → 합 22 ❌
    21 → 1, 3, 7 → 합 11 ❌
    22 → 1, 2, 11 → 합 14 ❌
    23 → 1 → 합 1 ❌
    24 → 1, 2, 3, 4, 6, 8, 12 → 합 36 ❌
    25 → 1, 5 → 합 6 ❌
    26 → 1, 2, 13 → 합 16 ❌
    27 → 1, 3, 9 → 합 13 ❌
    28 → 1, 2, 4, 7, 14 → 합 28 ✅ 완전수
    29 → 1 → 합 1 ❌
    30 → 1, 2, 3, 5, 6, 10, 15 → 합 42 ❌

    ✅ 완전수는 6, 28 두 개 존재
    ==============================

    ✅ 최종 출력값: 2
    ==============================
    */

    return 0;
}
