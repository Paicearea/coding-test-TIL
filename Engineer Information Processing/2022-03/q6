public class Exam {
  public static void main(String[] args) {

    int a = 0;  // 조건을 만족하는 수를 저장할 변수

    // ✅ 1️⃣ 1부터 998까지 반복
    for (int i = 1; i < 999; i++) {

      // ✅ 2️⃣ 조건 검사
      // i가 3의 배수(i%3==0)이면서 짝수가 아닌(i%2!=0) 경우
      if (i % 3 == 0 && i % 2 != 0) {
        a = i;  // 조건 만족 시 a를 i로 갱신
      }
    }

    // ✅ 3️⃣ 반복이 끝나면 a에는 "마지막으로 조건을 만족한 수"가 저장됨
    System.out.print(a);

    /*
    ============================
    🔍 실행 과정 요약
    ============================
    조건: (i % 3 == 0 && i % 2 != 0)
         → 3의 배수이면서 2의 배수가 아닌 수
         → 즉, 홀수인 3의 배수

    3의 배수: 3, 6, 9, 12, 15, ...
    이 중에서 홀수만: 3, 9, 15, 21, 27, ...

    999보다 작은 홀수 3의 배수 중 마지막 수는?
      3 × 333 = 999  ← 이건 999이므로 제외 (i<999)
      따라서 마지막 홀수 3의 배수는 993

    반복문 마지막에 a = 993으로 갱신됨
    ============================

    ✅ 최종 출력값: 993
    */
  }
}
