#include <stdio.h>

int main(void) {

    // ✅ 1️⃣ 입력 배열과 결과 배열 선언
    int arr[5] = {77, 32, 10, 99, 50};  // 비교할 숫자 목록
    int result[5];                      // 각 숫자의 순위를 저장할 배열

    // ✅ 2️⃣ 각 원소의 순위 계산 시작
    for (int i = 0; i < 5; i++) {
        result[i] = 1;  // 기본 순위는 1위부터 시작 (자기 자신 포함)

        // 배열의 모든 다른 값과 비교
        for (int j = 0; j < 5; j++) {
            if (arr[i] < arr[j]) { // 자신보다 큰 값이 있으면
                result[i]++;        // 순위를 한 단계 내림
            }
        }
    }

    // ✅ 3️⃣ 계산 결과 출력
    for (int k = 0; k < 5; k++) {
        printf("%d ", result[k]);  // 각 원소의 순위를 한 줄로 출력
    }

    /*
    ===============================
    🔍 순위 계산 과정 요약
    ===============================

    arr = {77, 32, 10, 99, 50}

    ▷ i=0 → arr[0]=77
       비교: 77<99 → 1번만 참 → result[0]=2

    ▷ i=1 → arr[1]=32
       비교: 32<77, 32<99, 32<50 → 3번 참 → result[1]=4

    ▷ i=2 → arr[2]=10
       비교: 10<77, 10<32, 10<99, 10<50 → 4번 참 → result[2]=5

    ▷ i=3 → arr[3]=99
       비교: 99보다 큰 값 없음 → result[3]=1

    ▷ i=4 → arr[4]=50
       비교: 50<77, 50<99 → 2번 참 → result[4]=3

    ===============================
    ✅ 최종 result 배열 값
       result = {2, 4, 5, 1, 3}
    ===============================

    ✅ 최종 출력 결과:
       2 4 5 1 3
    ===============================
    */

    return 0;
}
