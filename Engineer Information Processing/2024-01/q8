#include <stdio.h>
#include <ctype.h>

int main(){
    char *p = "It is 8";    // 원본 문자열
    char result[100];       // 결과 저장용 배열
    int i;

    for(i = 0; p[i] != '\0'; i++){   // '\0' (문자열 끝) 전까지 반복

        if(isupper(p[i]))            // ① 대문자인 경우
            /*
               [문자: I]
               'I' - 'A' = 8
               (8 + 5) % 25 = 13
               13 + 'A' = 13 + 65 = 78 → 'N'
               → result[i] = 'N'
            */
            result[i] = (p[i] - 'A' + 5) % 25 + 'A';

        else if(islower(p[i]))       // ② 소문자인 경우
            /*
               첫 번째 소문자: 't'
               't' - 'a' = 19
               (19 + 10) % 26 = 29 % 26 = 3
               3 + 'a' = 100 → 'd'
               → result[i] = 'd'
               
               다음 'i':
               'i' - 'a' = 8
               (8 + 10) % 26 = 18
               18 + 'a' = 115 → 's'
               → result[i] = 's'

               다음 's':
               's' - 'a' = 18
               (18 + 10) % 26 = 28 % 26 = 2
               2 + 'a' = 99 → 'c'
               → result[i] = 'c'
            */
            result[i] = (p[i] - 'a' + 10) % 26 + 'a';

        else if(isdigit(p[i]))       // ③ 숫자인 경우
            /*
               [문자: '8']
               '8' - '0' = 8
               (8 + 3) % 10 = 11 % 10 = 1
               1 + '0' = 49 → '1'
               → result[i] = '1'
            */
            result[i] = (p[i] - '0' + 3) % 10 + '0';

        else if(!(isupper(p[i]) || islower(p[i]) || isdigit(p[i])))
            /*
               [문자: 공백 ' ']
               문자가 알파벳이나 숫자가 아니므로 그대로 저장
               → result[i] = ' '
            */
            result[i] = p[i];
    }

    result[i] = '\0'; // 문자열 끝 표시

    /*
       🔍 변환 결과 요약:
       원본: "I t   i s   8"
       -------------------
       'I' → 'N'
       't' → 'd'
       ' ' → ' '
       'i' → 's'
       's' → 'c'
       ' ' → ' '
       '8' → '1'
       -------------------
       result = "Nd sc 1"
    */

    printf("%s\n", result); // 최종 출력: Nd sc 1

    return 0;
}
