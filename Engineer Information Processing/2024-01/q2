#include <stdio.h>
 
int main() {
    int v1 = 0, v2 = 35, v3 = 29;
    
    // ⚙️ if문의 조건 부분
    // (v1 > v2 ? v2 : v1)
    //  → 삼항 연산자: (조건) ? (참일 때 값) : (거짓일 때 값)
    //
    // ① v1 > v2 → 0 > 35 → 거짓(false)
    // ② 거짓이면 → v1을 선택
    // 따라서 (v1 > v2 ? v2 : v1) 의 결과는 v1 (= 0)
    //
    // ⚠️ if(0)은 false 이므로 else문이 실행됨

    if (v1 > v2 ? v2 : v1) {
        v2 = v2 << 2;   // 이 부분은 실행되지 않음
    } else {
        v3 = v3 << 2;   // 실행됨 → v3 = 29 << 2
    }

    // << 2 → 왼쪽으로 2비트 이동 (× 2^2 = ×4)
    // v3 = 29 * 4 = 116

    // v2는 변화 없음 (35 그대로)
    // v2 + v3 = 35 + 116 = 151

    printf("%d", v2 + v3); // 151 출력
}
