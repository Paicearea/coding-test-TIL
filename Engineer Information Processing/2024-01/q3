#include <stdio.h>
#include <string.h>
 
// ✅ 문자열을 뒤집는 함수
void reverse(char* str){
    int len = strlen(str);      // 문자열 길이 계산 → "ABCDEFGH" → 8
    char temp;
    char* p1 = str;             // p1: 문자열의 시작 (A)
    char* p2 = str + len - 1;   // p2: 문자열의 끝 (H)

    // 반복문: p1이 p2보다 왼쪽에 있는 동안 양쪽 문자 교환
    while(p1 < p2){
        temp = *p1;   // 앞 문자 임시 보관
        *p1 = *p2;    // 뒤 문자를 앞으로 이동
        *p2 = temp;   // 임시 보관한 문자를 뒤로 이동

        // 포인터 이동
        p1++;
        p2--;
    }

    /*
        🔄 교환 과정
        1회차: A↔H → H B C D E F G A
        2회차: B↔G → H G C D E F B A
        3회차: C↔F → H G F D E C B A
        4회차: D↔E → H G F E D C B A
        이후 p1 >= p2 → 종료

        ✅ reverse 이후 str = "HGFEDCBA"
    */
}
 
int main(int argc, char* argv[]){
    char str[100] = "ABCDEFGH"; // 원본 문자열

    reverse(str); // 문자열 뒤집기 호출

    // reverse 이후 상태: str = "HGFEDCBA"
    int len = strlen(str); // len = 8

    /*
        인덱스별 문자
        [0] H
        [1] G
        [2] F
        [3] E
        [4] D
        [5] C
        [6] B
        [7] A
    */

    // i를 1부터 시작해서 2씩 증가 → 인덱스 1, 3, 5, 7만 출력
    for(int i = 1; i < len; i += 2){
        printf("%c", str[i]);
        /*
            i=1 → str[1]='G' 출력 → 현재 출력: G
            i=3 → str[3]='E' 출력 → 현재 출력: GE
            i=5 → str[5]='C' 출력 → 현재 출력: GEC
            i=7 → str[7]='A' 출력 → 현재 출력: GECA
        */
    }

    printf("\n"); // 줄바꿈
    return 0;
}

