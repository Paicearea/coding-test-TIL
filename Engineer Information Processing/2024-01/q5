#include <stdio.h>

/*
  BankAcc: 계좌번호(accNum)와 잔액(bal)을 가지는 단순 구조체
*/
typedef struct{
    int accNum;
    double bal;
}BankAcc;

/*
  sim_pow(base, year):
  - 반복문으로 base^year(거듭제곱)를 구하는 함수
  - 예) base=1.1, year=3 → 1.1 * 1.1 * 1.1 = 1.331
*/
double sim_pow(double base, int year){
    int i;
    double r = 1.0;

    for(i=0; i<year; i++){
        r = r * base;
    }
    return r;
}

/*
  initAcc(acc, x, y):
  - 계좌를 초기화한다.
  - accNum = x, bal = y
*/
void initAcc(BankAcc *acc, int x, double y){
    acc->accNum = x;
    acc->bal = y;
}

/*
  xxx(acc, en):
  - 입출금 로직
  - *en(금액)이 0보다 크고, 현재 잔액보다 작으면 → 출금 (bal -= *en)
  - 그 외(금액이 0 이하이거나 잔액보다 크거나 같으면) → 입금 (bal += *en)
*/
void xxx(BankAcc *acc, double *en){
    if (*en > 0 && *en < acc->bal) {
        // 이번 케이스: en = 100.0, acc->bal = 2200.0
        // 0 < 100.0 < 2200.0 → 참 → 출금
        acc->bal = acc->bal - *en;   // 2200.0 - 100.0 = 2100.0
    } else {
        acc->bal = acc->bal + *en;
    }
}

/*
  yyy(acc):
  - 연 10% 이자(=1.1)를 3년 복리로 적용
  - acc->bal *= (1 + 0.1)^3 = 1.1^3 = 1.331
*/
void yyy(BankAcc *acc){
    acc->bal = acc->bal * sim_pow((1+0.1), 3);
    // 이번 케이스: acc->bal = 2100.0 * 1.331 = 2795.1
}

int main(){
    BankAcc myAcc;

    // 1) 계좌 초기화: 계좌번호=9981, 잔액=2200.0
    initAcc(&myAcc, 9981, 2200.0);

    // 2) 거래 금액 설정
    double amount = 100.0;

    // 3) xxx: 조건(0 < 100.0 < 2200.0) 만족 → 출금
    //    myAcc.bal: 2200.0 → 2100.0
    xxx(&myAcc, &amount);

    // 4) yyy: 3년 복리 10% 적용 → 2100.0 * 1.331 = 2795.1
    yyy(&myAcc);

    // 5) 출력: 계좌번호와 잔액(소수 둘째자리까지)
    //    "9981 and 2795.10"
    printf("%d and %.2f", myAcc.accNum, myAcc.bal);

    return 0;
}

/*
==================== 실행 요약 ====================
초기 잔액: 2200.00
거래 금액: 100.00

[xxx 단계]
- 0 < 100.0 < 2200.0 → 출금
- 잔액: 2200.00 → 2100.00

[yyy 단계]
- 이자: 10% 복리 3년 → 1.1^3 = 1.331
- 잔액: 2100.00 * 1.331 = 2795.10

[최종 출력]
9981 and 2795.10
=================================================
*/
