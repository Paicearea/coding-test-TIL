#include <stdio.h>

int main(void) {
    int n[5];
    int i;

    /*
    ============================
      🧠 프로그램 설명
    ============================
      ✔ 사용자로부터 5개의 정수를 입력받아 배열 n[]에 저장한다.
      ✔ 이후 n[(i+1)%5]를 출력하는데,
        → 이는 인덱스를 한 칸씩 오른쪽으로 "회전시켜" 출력하는 효과가 있다.
        → 즉, n[0] 대신 n[1], n[1] 대신 n[2] ... n[4] 대신 n[0] 출력.
      
      예시)
      입력: 5 4 3 2 1
      인덱스: n[0]=5, n[1]=4, n[2]=3, n[3]=2, n[4]=1

      출력 순서:
      n[(0+1)%5] = n[1] = 4
      n[(1+1)%5] = n[2] = 3
      n[(2+1)%5] = n[3] = 2
      n[(3+1)%5] = n[4] = 1
      n[(4+1)%5] = n[0] = 5

      최종 출력: 43215
    ============================
    */

    // ① 사용자로부터 5개의 정수를 입력받는다.
    for (i = 0; i < 5; i++) {
        printf("숫자를 입력해주세요 : ");
        scanf("%d", &n[i]);  // i번째 입력값을 n[i]에 저장
    }

    // ② n[(i+1)%5] 출력
    for (i = 0; i < 5; i++) {
        /*
          (i + 1) % 5
          - 인덱스를 하나씩 증가시키며, 마지막에 도달하면 다시 0으로 돌아감.
          - 즉, 배열이 원형으로 회전하듯 출력됨.

          i=0 → (0+1)%5 = 1 → n[1]
          i=1 → (1+1)%5 = 2 → n[2]
          i=2 → (2+1)%5 = 3 → n[3]
          i=3 → (3+1)%5 = 4 → n[4]
          i=4 → (4+1)%5 = 0 → n[0]
        */
        printf("%d", n[(i + 1) % 5]);
    }

    /*
      ✅ 예시 실행 결과

      입력:
      5
      4
      3
      2
      1

      배열 저장:
      n[0] = 5
      n[1] = 4
      n[2] = 3
      n[3] = 2
      n[4] = 1

      출력:
      43215
    */

    return 0;
}
