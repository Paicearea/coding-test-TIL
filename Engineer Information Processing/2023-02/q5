#include <stdio.h>

int main() {

    int c = 0;  // ✅ 4의 배수 개수를 세는 변수
                 // 시작 시 0으로 초기화

    // ✅ 1부터 2023까지 반복
    for (int i = 1; i <= 2023; i++) {
        // i를 4로 나눈 나머지가 0이면 → 4의 배수
        if (i % 4 == 0)
            c++;  // 4의 배수를 발견할 때마다 카운트 증가
    }

    /*
       🔍 과정 해설
       1~2023 중 4의 배수는:
       4, 8, 12, 16, ..., 2020

       4의 배수 개수 = 2023을 4로 나눈 몫
                     = 2023 / 4
                     = 505 (정수 나눗셈)
       즉, 4의 배수는 총 505개 존재
    */

    printf("%d", c);  // 결과 출력 → 505

    /*
       ✅ 최종 출력값:
       505
    */

    return 0;
}
