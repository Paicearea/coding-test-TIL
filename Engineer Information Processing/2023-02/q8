#include <stdio.h>

int main() {
    // ✅ 초기 데이터: 정렬되지 않은 배열
    int E[] = {64, 25, 12, 22, 11};

    // ✅ 배열의 크기 계산
    // sizeof(E) : 배열 전체 바이트 크기
    // sizeof(E[0]) : int형 한 칸의 크기 (4바이트)
    // 전체 크기 / 한 칸 크기 = 요소 개수 (5)
    int n = sizeof(E) / sizeof(E[0]);

    int i = 0; // 바깥쪽 루프 인덱스 (비교 기준이 되는 위치)

    // =============================
    // ▶ 선택 정렬(Selection Sort)
    //    : i번째 자리에 올 가장 작은 값을 찾아서 교환
    // =============================
    do {
        int j = i + 1; // 안쪽 루프 인덱스 (i 다음 원소부터 비교 시작)

        do {
            // ⚙️ 오름차순 정렬 조건
            // 만약 왼쪽 값이 오른쪽 값보다 크다면 → 순서가 잘못된 것 → 교환
            if (E[i] > E[j]) {  // ← 정답 연산자
                int tmp = E[i];  // 값 임시 저장
                E[i] = E[j];     // 더 작은 값 앞으로 이동
                E[j] = tmp;      // 큰 값 뒤로 이동
            }

            j++; // 다음 원소로 이동
        } while (j < n); // 배열 끝까지 비교

        i++; // 다음 기준 위치로 이동
    } while (i < n - 1); // 마지막 원소 전까지 반복 (마지막은 자동 정렬됨)

    // ✅ 정렬 완료 후 결과 출력
    for (int i = 0; i <= 4; i++)
        printf("%d ", E[i]);

    /*
      ================================
          🔍 정렬 과정 요약
      ================================
      초기: {64, 25, 12, 22, 11}

      1회차 (i=0)
        64>25 → swap → {25,64,12,22,11}
        25>12 → swap → {12,64,25,22,11}
        12>22 → 그대로
        12>11 → swap → {11,64,25,22,12}

      2회차 (i=1)
        64>25 → swap → {11,25,64,22,12}
        25>22 → swap → {11,22,64,25,12}
        22>12 → swap → {11,12,64,25,22}

      3회차 (i=2)
        64>25 → swap → {11,12,25,64,22}
        25>22 → swap → {11,12,22,64,25}

      4회차 (i=3)
        64>25 → swap → {11,12,22,25,64}

      최종 결과: {11, 12, 22, 25, 64}
    */

    return 0;
}
