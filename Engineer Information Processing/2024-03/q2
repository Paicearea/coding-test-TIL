def func(lst):
  # 리스트를 절반 길이만큼 순회하면서
  # 양쪽 끝을 서로 교환 → 리스트 뒤집기(reverse)
  for i in range(len(lst) // 2):
    lst[i], lst[-i - 1] = lst[-i - 1], lst[i]


lst = [1, 2, 3, 4, 5, 6]

# func 호출 후 lst는 뒤집힘
# 원래: [1, 2, 3, 4, 5, 6]
# 뒤집은 후: [6, 5, 4, 3, 2, 1]
func(lst)

# [::2] → 짝수 인덱스 요소 (0, 2, 4)
# [1::2] → 홀수 인덱스 요소 (1, 3, 5)

# 짝수 인덱스 합 = 6 + 4 + 2 = 12
# 홀수 인덱스 합 = 5 + 3 + 1 = 9
# 차이 = 12 - 9 = 3
print(sum(lst[::2]) - sum(lst[1::2]))  # 출력: 3
