#include <stdio.h>

// func: 배열의 각 요소를 수정하는 함수
void func(int** arr, int size){
  for (int i = 0; i < size; i++) {
    // *arr → int* (배열 시작 주소)
    // *(*arr + i) → 배열의 i번째 원소 (즉 arr[i])
    // arr[i] = (arr[i] + i) % size
    *(*arr + i) = (*(*arr + i) + i) % size;
  }
}

int main() {
  int arr[] = {3, 1, 4, 1, 5};  // 초기 배열
  int* p = arr;                 // p는 arr의 시작 주소
  int** pp = &p;                // pp는 p의 주소 (이중 포인터)
  int num = 6;                  // 임의 변수

  func(pp, 5);  // 배열의 크기 5 전달 → arr 수정 시작

  /*
     func 실행 시 배열 변경 과정:
     size = 5

     i=0 → arr[0] = (3 + 0) % 5 = 3
     i=1 → arr[1] = (1 + 1) % 5 = 2
     i=2 → arr[2] = (4 + 2) % 5 = 1
     i=3 → arr[3] = (1 + 3) % 5 = 4
     i=4 → arr[4] = (5 + 4) % 5 = 9 % 5 = 4

     최종 arr = {3, 2, 1, 4, 4}
  */

  num = arr[2];   // arr[2] = 1
  printf("%d", num); // 출력: 1

  return 0;
}
