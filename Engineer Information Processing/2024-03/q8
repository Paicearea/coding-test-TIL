public class ExceptionHandling {
  public static void main(String[] args) {
      int sum = 0;

      try {
          func();                 // (1) func() 호출 → 예외 발생
      } 
      catch (NullPointerException e) {
          // (3) 던져진 예외가 NullPointerException이므로 이 블록이 실행됨
          sum = sum + 1;          // sum = 0 + 1 → 1
      } 
      catch (Exception e) {
          // (X) 실행되지 않음 (이미 위에서 처리됨)
          sum = sum + 10;
      } 
      finally {
          // (4) 예외 발생 여부와 관계없이 항상 실행
          sum = sum + 100;        // sum = 1 + 100 → 101
      }

      System.out.print(sum);      // (5) 최종 출력
  }

  static void func() throws Exception {
      // (2) 이 메서드는 NullPointerException 발생시킴
      throw new NullPointerException(); 
  }
}
