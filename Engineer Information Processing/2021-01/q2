public class good {
    public static void main(String[] args) {

        // 2차원 배열 선언 및 초기화
        // arr[0] = {45, 50, 75} → 길이 3
        // arr[1] = {89}         → 길이 1
        int[][] arr = new int[][]{{45, 50, 75}, {89}};

        // arr[0]은 첫 번째 1차원 배열 → {45, 50, 75}
        // arr[0].length = 3
        System.out.println(arr[0].length);   // ① 출력: 3

        // arr[1]은 두 번째 1차원 배열 → {89}
        // arr[1].length = 1
        System.out.println(arr[1].length);   // ② 출력: 1

        // arr[0][0] → 첫 번째 배열의 첫 번째 요소
        // 45 출력
        System.out.println(arr[0][0]);       // ③ 출력: 45

        // arr[0][1] → 첫 번째 배열의 두 번째 요소
        // 50 출력
        System.out.println(arr[0][1]);       // ④ 출력: 50

        // arr[1][0] → 두 번째 배열의 첫 번째 요소
        // 89 출력
        System.out.println(arr[1][0]);       // ⑤ 출력: 89
    }
}

; 3
; 1
; 45
; 50
; 89