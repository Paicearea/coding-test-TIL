#include <stdio.h>
 
int main() {
    int *arr[3];      // int형 포인터 3개를 저장할 수 있는 배열 선언
                      // 즉, arr[0], arr[1], arr[2]는 각각 int를 가리키는 포인터임

    int a = 12, b = 24, c = 36;  // 정수 변수 3개 선언 및 초기화

    arr[0] = &a;      // arr[0] → 변수 a의 주소 저장
    arr[1] = &b;      // arr[1] → 변수 b의 주소 저장
    arr[2] = &c;      // arr[2] → 변수 c의 주소 저장

    /*
      arr = [ &a, &b, &c ]
      *arr[0] → a의 값(12)
      *arr[1] → b의 값(24)
      *arr[2] → c의 값(36)
    */

    // 이제 식을 분석해보자:
    // printf("%d\n", *arr[1] + **arr + 1);
    //
    // 1️⃣ *arr[1] → arr[1]이 가리키는 값 = b = 24
    // 2️⃣ **arr   → arr은 포인터 배열의 첫 요소 &a를 가리킴
    //                *arr은 arr[0]과 동일 → &a
    //                **arr → a의 실제 값 = 12
    // 3️⃣ *arr[1] + **arr + 1 → 24 + 12 + 1 = 37

    printf("%d\n", *arr[1] + **arr + 1);  // 24 + 12 + 1 = 37 출력
}
