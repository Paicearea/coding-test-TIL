#include <stdio.h>
 
// ✅ jsu 구조체 정의
// 학생 이름(name), 과목 점수(os, db), 합계(hab), 누적합(hhab)을 저장
struct jsu {
  char name[12];
  int os, db, hab, hhab;
};
 
int main() {
  // ✅ 구조체 배열 st 선언 및 초기화
  // 각각의 구조체에 이름과 두 과목 점수(os, db)를 저장
  struct jsu st[3] = {
    {"데이터1", 95, 88},   // st[0] → os=95, db=88
    {"데이터2", 84, 91},   // st[1] → os=84, db=91
    {"데이터3", 86, 75}    // st[2] → os=86, db=75
  };

  struct jsu* p;   // 구조체 포인터 선언
  p = &st[0];      // p는 st[0]을 가리킴 (즉, p → st[0])

  /*
    포인터 연산 복습:
    p         → st[0]
    (p + 1)   → st[1]
    (p + 2)   → st[2]
  */

  // ✅ (p + 1)->hab
  // = st[1].hab = st[1].os + st[2].db
  // = 84 + 75 = 159
  (p + 1)->hab = (p + 1)->os + (p + 2)->db;  

  // ✅ (p + 1)->hhab
  // = st[1].hhab = st[1].hab + st[0].os + st[0].db
  // = 159 + 95 + 88 = 342
  (p + 1)->hhab = (p + 1)->hab + p->os + p->db;  

  // ✅ 출력: st[1].hab + st[1].hhab
  // = 159 + 342 = 501
  printf("%d\n", (p + 1)->hab + (p + 1)->hhab);
}
