#include <stdio.h>

void main() {
    int i = 0, c = 0;   // 변수 초기화
                        // i는 반복 제어용 (0부터 시작)
                        // c는 곱셈 결과 저장용, 현재 0

    // while문: i가 10보다 작을 동안 반복 수행
    while (i < 10) {

        i++;            // i를 1 증가 → 첫 반복 시 i=1부터 시작

        c *= i;         // c = c * i
                        // ⚠️ c의 초기값이 0이므로
                        // 첫 번째 계산: c = 0 * 1 → 0
                        // 이후 어떤 i가 되어도 (0 * i = 0)
                        // c는 계속 0으로 유지됨

        /*
          🔍 반복문 내부 변수 변화 요약:
          ┌──────┬────┬────┐
          │ 반복  │  i  │  c  │
          ├──────┼────┼────┤
          │ 초기  │  0  │  0  │
          │ 1회차 │  1  │  0  │ (0*1=0)
          │ 2회차 │  2  │  0  │ (0*2=0)
          │ 3회차 │  3  │  0  │ (0*3=0)
          │ ...  │ ... │  0  │
          │ 10회차│ 10 │  0  │ (0*10=0)
          └──────┴────┴────┘

          따라서 c는 10번 반복 동안에도 한 번도 변하지 않음.
        */
    }

    // 반복문 종료 후 i=10, c=0 상태
    printf("%d", c);    // c의 값(=0) 출력

    /*
       ✅ 최종 결과 설명:
       - c는 처음부터 0으로 초기화되었음
       - 0에 어떤 수를 곱해도 결과는 항상 0
       - 따라서 반복문이 끝나도 c는 여전히 0
       🔸 최종 출력값: 0
    */
}
