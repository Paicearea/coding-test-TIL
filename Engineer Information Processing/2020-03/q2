#include <stdio.h>

int r1() {
    // r1은 단순히 4를 반환
    return 4;
}

int r10() {
    // r1()을 호출하여 4를 받아오고, 30을 더해서 반환
    // 30 + 4 = 34
    return (30 + r1());
}

int r100() {
    // r10()을 호출하여 34를 받아오고, 200을 더해서 반환
    // 200 + 34 = 234
    return (200 + r10());
}

int main() {
    // 최종적으로 r100() = 234이므로 234 출력
    printf("%d\n", r100());   // 출력: 234
    return 0;
}
