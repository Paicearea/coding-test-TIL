public class good {
    public static void main(String[] args) {
        int i = 0;
        int sum = 0;

        while (i < 10) {   // i가 0~9일 동안 반복
            i++;           // 반복마다 i를 1 증가 (1부터 10까지)
            
            if (i % 2 == 1)   // i가 홀수면
                continue;     // 아래 sum += i 문을 건너뛰고 다음 반복으로 이동
            
            sum += i;         // 짝수만 sum에 더함
        }

        // 🔹 최종적으로 sum = 2 + 4 + 6 + 8 + 10 = 30
        System.out.println(sum);  // ✅ 출력: 30
    }
}
