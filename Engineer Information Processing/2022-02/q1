public class Main {
  public static void main(String args[]) {
  
    int i = 3;   // switch 조건 변수
    int k = 1;   // 결과 누적 변수

    switch(i) {

      case 1: 
        k += 1;   // i가 1이면 k=2가 되지만,
                  // 지금 i=3이므로 이 줄은 실행되지 않음
        // break; ← 없음

      case 2: 
        k++;      // i=3이므로 여기도 건너뜀
        // break; ← 없음

      case 3: 
        k = 0;    // ✅ i==3 → 여기서부터 실행 시작!
        // break; ← 없으므로 아래 case들도 “전부 연속 실행”

      case 4: 
        k += 3;   // k = 0 + 3 → 3

      case 5: 
        k -= 10;  // k = 3 - 10 → -7

      default: 
        k--;      // k = -7 - 1 → -8
    }

    System.out.print(k);

    /*
    ===============================
    🔍 실행 순서 정리
    ===============================
    1️⃣ i == 3 → case 3부터 실행
        k = 0

    2️⃣ break가 없으므로 ↓ 연속 실행

    3️⃣ case 4: k += 3 → k = 3
    4️⃣ case 5: k -= 10 → k = -7
    5️⃣ default: k-- → k = -8

    ✅ 최종 k = -8
    ===============================
    */
  }
}
