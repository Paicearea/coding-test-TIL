#include <stdio.h>

int main(int argc, char *argv[]) {
    int a[4] = {0, 2, 4, 8};  // 기준 배열
    int b[3] = {0};           // 차이 저장 배열(길이 3) — 0으로 초기화
    int i = 1;                // i는 1부터 시작 (b는 i-1 인덱스를 사용)
    int sum = 0;              // 누적 합
    int *p1;                  // 포인터로 a의 i번째 원소를 가리킴

    /*
      반복 구조 개요
      - i = 1,2,3 동안 수행 (i < 4)
      - p1 = a + i           → p1가 a[i]를 가리킴
      - b[i-1] = *p1 - a[i-1]→ b[i-1] = a[i] - a[i-1] (인접 차이)
      - sum += b[i-1] + a[i] → 누적 합에 (차이 + 현재값) 더함
    */

    for (i; i < 4; i++) {

        p1 = a + i;                 // p1 → a[i]

        b[i - 1] = *p1 - a[i - 1]; // b[i-1] = a[i] - a[i-1]

        sum = sum + b[i - 1] + a[i]; // sum에 (차이 + a[i]) 더하기

        /* 단계별 상태 로그 (설명용 주석)
           i=1:
             p1 -> a[1]=2
             b[0] = a[1]-a[0] = 2-0 = 2
             sum = 0 + 2 + a = 4
           i=2:
             p1 -> a[2]=4
             b[1] = a[2]-a[1] = 4-2 = 2
             sum = 4 + 2 + a = 10
           i=3:
             p1 -> a[3]=8
             b[2] = a[3]-a[2] = 8-4 = 4
             sum = 10 + 4 + a = 22
        */
    }

    // 최종적으로 sum = 22
    printf("%d", sum);  // ✅ 최종 출력: 22

    return 0;
}
