#include <stdio.h>

/* ✅ 문자열 길이를 구하는 함수 선언 */
int len(char *p);

int main() {

    char *p1 = "2022";    // 문자열 1
    char *p2 = "202207";  // 문자열 2

    /* ✅ 각 문자열의 길이를 계산 */
    int a = len(p1);  // len("2022") → 4
    int b = len(p2);  // len("202207") → 6

    /* ✅ 두 길이의 합 출력 */
    printf("%d", a + b);

    /*
    ==============================
    🔍 실행 과정 요약
    ==============================
    p1 → "2022"
       → 문자 개수: '2','0','2','2' → 4글자
       → a = 4

    p2 → "202207"
       → 문자 개수: '2','0','2','2','0','7' → 6글자
       → b = 6

    a + b = 4 + 6 = 10
    ==============================

    ✅ 최종 출력값: 10
    ==============================
    */

    return 0;
}

/* ✅ len 함수 정의 */
int len(char *p) {
    int r = 0;             // 길이 카운터 초기화
    while (*p != '\0') {   // 문자열 끝(널 문자) 전까지 반복
        p++;               // 다음 문자로 이동
        r++;               // 카운트 증가
    }
    return r;              // 최종 길이 반환
}
