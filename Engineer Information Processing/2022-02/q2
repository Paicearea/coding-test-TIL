#include <stdio.h>

/* ✅ 구조체 정의 */
struct A {
    int n;
    int g;
};

int main() {
    /* ✅ 구조체 배열 선언 */
    struct A a[2];

    /* ✅ 구조체 배열의 각 멤버 초기화 */
    for (int i = 0; i < 2; i++) {
        a[i].n = i;      // n: 0, 1
        a[i].g = i + 1;  // g: 1, 2
    }

    /* ✅ 값 계산 및 출력 */
    // a[0].n = 0
    // a[1].g = 2
    // 합 = 0 + 2 = 2
    printf("%d", a[0].n + a[1].g);

    /*
    ==============================
    🔍 실행 과정 요약
    ==============================

    i=0 → a[0].n=0, a[0].g=1
    i=1 → a[1].n=1, a[1].g=2

    a[0].n + a[1].g = 0 + 2 = 2

    ✅ 최종 출력 결과: 2
    ==============================
    */

    return 0;
}
