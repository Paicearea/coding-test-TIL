public class good {
    public static void main(String[] args) {
        int i;                         // 반복문에서 사용할 변수 i 선언
        int[] a = {0, 1, 2, 3};        // 정수형 배열 a 선언 및 초기화
                                        // a[0]=0, a[1]=1, a[2]=2, a[3]=3

        // for문을 이용해 배열의 모든 요소를 차례대로 출력
        for (i = 0; i < 4; i++) {      // i는 0부터 3까지 반복 (총 4번)
            System.out.print(a[i] + " ");  
            /*
              🔍 실행 순서 및 출력 과정
              i=0 → a[0]=0 → "0 "
              i=1 → a[1]=1 → "1 "
              i=2 → a[2]=2 → "2 "
              i=3 → a[3]=3 → "3 "
              
              반복이 끝나면 화면에는 "0 1 2 3 " 이 출력됨
            */
        }
    }
}
