#include <stdio.h>

void main() {
    int i, j;
    int temp;
    int a[5] = {75, 95, 85, 100, 50};  // 초기 배열 선언 및 초기화

    /*
      🔹 버블 정렬 (Bubble Sort)
      - 인접한 두 수를 비교하여 순서를 바꿔가며 전체를 오름차순으로 정렬하는 방식
      - 한 바퀴(i가 1 증가) 돌 때마다 가장 큰 값이 맨 뒤로 이동한다.
      - 총 n-1(=4)번 반복하면 정렬 완료됨
    */

    for (i = 0; i < 4; i++) {            // 배열의 크기(5) - 1 = 4번 반복
        for (j = 0; j < 4 - i; j++) {    // 점점 비교 범위가 줄어듦
            if (a[j] > a[j + 1]) {       // 앞의 값이 뒤보다 크면 교환
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }

        /*
          🔍 각 회전별 결과 확인 (참고용 설명)
          i=0 → {75, 85, 95, 50, 100}
          i=1 → {75, 85, 50, 95, 100}
          i=2 → {75, 50, 85, 95, 100}
          i=3 → {50, 75, 85, 95, 100}
          ✅ i=3에서 모든 숫자가 오름차순으로 정렬 완료
        */
    }

    // 🔹 최종 정렬된 배열 출력
    for (i = 0; i < 5; i++) {
        printf("%d ", a[i]);
    }

    /*
      🧩 최종 과정 요약
      -------------------------------
      초기 배열: 75, 95, 85, 100, 50
      1회차(i=0): 가장 큰 100이 맨 뒤로 이동
      2회차(i=1): 95가 4번째로 이동
      3회차(i=2): 85 정위치
      4회차(i=3): 50이 가장 앞으로 이동
      -------------------------------
      🎯 최종 정렬 결과: 50 75 85 95 100
    */

    // ✅ 결론: 버블 정렬을 이용하여 오름차순으로 정렬한 결과
    //          최종 출력값은 "50 75 85 95 100"
}
