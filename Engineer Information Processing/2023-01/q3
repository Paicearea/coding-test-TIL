#include <stdio.h>

int main() {

    char* a = "qwer";     // 첫 번째 문자열
    char* b = "qwtety";   // 두 번째 문자열

    // 두 중첩 for문으로 모든 문자 비교
    for (int i = 0; a[i] != '\0'; i++) {       // a의 각 문자 순회
        for (int j = 0; b[j] != '\0'; j++) {   // b의 각 문자 순회
            if (a[i] == b[j])                  // 문자가 같다면
                printf("%c", a[i]);            // 공통 문자 출력
        }
    }

    return 0;
}

/*
====================================
🔍 문자열 비교 과정 (단계별 분석)
====================================

a = "qwer"
b = "qwtety"

a[0] = 'q'
   → b = q w t e t y
      'q' == 'q' → 출력 'q'

a[1] = 'w'
   → b = q w t e t y
      'w' == 'w' → 출력 'w'

a[2] = 'e'
   → b = q w t e t y
      'e' == 'e' → 출력 'e'

a[3] = 'r'
   → b = q w t e t y
      'r'는 없음 → 출력 X

====================================
✅ 최종 출력 문자 순서
====================================
'q' → 'w' → 'e'

✅ 최종 출력 결과:
qwe
====================================
*/
