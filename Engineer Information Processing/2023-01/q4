#include <stdio.h>

int main() {

    int input = 101110;  // 2진수 형태의 입력 (정수형으로 저장)
    int di = 1;          // 2의 제곱을 나타내는 변수 (1, 2, 4, 8, ...)
    int sum = 0;         // 결과값(10진수) 저장용

    while (1) {
        if (input == 0) break;   // 모든 자리를 다 처리하면 반복 종료
        else {
            // (a)(b) 자리에 들어갈 식 → input % 10
            // 즉, 마지막 자릿수를 추출함 (2진수의 한 자리)
            sum = sum + (input % 10) * di;

            // di는 2씩 곱하면서 2의 제곱값으로 커짐
            di = di * 2;

            // 다음 자릿수로 이동 (10으로 나눠 뒤 한 자리 제거)
            input = input / 10;
        }
    }

    printf("%d", sum);  // 최종 10진수 결과 출력

    return 0;
}
