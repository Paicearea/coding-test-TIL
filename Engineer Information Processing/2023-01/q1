class Static {

    // ✅ 인스턴스 변수: 객체마다 따로 존재
    public int a = 20;

    // ✅ static(정적) 변수: 클래스 전체에서 하나만 공유됨
    static int b = 0;
}

public class Main {
    public static void main(String[] args) {

        int a;  // 지역 변수 (main 메서드 안에서만 유효)
        a = 10; // 지역 변수 a = 10

        // ⚙️ static 변수 b는 클래스 이름으로 직접 접근 가능
        Static.b = a;   // → Static.b = 10

        // ⚙️ 객체 생성 (인스턴스 변수 a는 20으로 초기화)
        Static st = new Static();

        // ==============================
        // ✅ 출력 과정 하나씩 분석
        // ==============================

        System.out.println(Static.b++);  
        // (1) 현재 Static.b 값(10)을 출력하고,
        // (2) 출력 후 b는 1 증가하여 b = 11
        // → 출력: 10

        System.out.println(st.b);
        // static 변수 b는 모든 객체가 공유하므로
        // Static.b == st.b == 11
        // → 출력: 11

        System.out.println(a);
        // 지역 변수 a = 10
        // → 출력: 10

        System.out.print(st.a);
        // st 객체의 인스턴스 변수 a = 20
        // → 출력: 20
    }
}

; 10
; 11
; 10
