#include <stdio.h>

int main() {

    char a[] = "Art";   // 문자열 리터럴을 복사한 배열: {'A','r','t','\0'}
    char* p = NULL;     // 문자 포인터
    p = a;              // 포인터 p가 배열 a의 첫 원소('A')를 가리킴

    // "%s"는 문자열(널 종료까지)을 출력 → a는 "Art"의 시작 주소
    printf("%s\n", a);  // 출력: Art

    // p는 a의 시작 주소를 가리킴 → *p는 첫 문자 'A'
    printf("%c\n", *p); // 출력: A

    // a는 배열 이름이므로 a == &a[0] → *a 역시 첫 문자 'A'
    printf("%c\n", *a); // 출력: A

    // "%s"에 p(= a의 시작 주소)를 넣음 → 문자열 전체 출력
    printf("%s\n", p);  // 출력: Art

    // a의 각 문자를 널 문자('\0') 전까지 하나씩 출력
    // i=0:'A', i=1:'r', i=2:'t', i=3:'\0'에서 종료
    for (int i = 0; a[i] != '\0'; i++)
        printf("%c", a[i]); // 출력: Art  (개행 없음)

    return 0;
}

/*
========================
🔍 출력 과정 요약
========================
1) printf("%s\n", a);  → "Art"
2) printf("%c\n", *p); → 'A'  (p는 a의 첫 문자 가리킴)
3) printf("%c\n", *a); → 'A'  (*a는 a[0]과 동일)
4) printf("%s\n", p);  → "Art" (p는 문자열 시작 주소)
5) for문                → "Art" (개행 없이 연속해서 출력)

✅ 최종 출력 (개행 포함 표시)
Art
A
A
Art
Art
*/
