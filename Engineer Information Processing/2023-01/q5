public class Sort {

    /**
     * 두 인덱스의 값을 교환하는 함수
     * - arr[idx1]와 arr[idx2]를 스왑한다.
     * - (1) 자리에 들어갈 것은 두 번째 인덱스인 'idx2'
     */
    public static void swap(int[] arr, int idx1, int idx2){
        int temp = arr[idx1];  // temp ← 왼쪽 값
        arr[idx1] = arr[idx2]; // 왼쪽 칸에 오른쪽 값 덮어쓰기
        arr[idx2] = temp;      // (1) 정답: idx2 → 오른쪽 칸에 temp 저장(스왑 완료)
    }

    /**
     * 버블 정렬 (오름차순)
     * - 인접한 두 원소를 비교해 '왼쪽이 더 크면' 교환
     * - 한 바퀴(i 1증가) 돌 때마다 가장 큰 값이 오른쪽 끝으로 '버블'처럼 떠오름
     * - length는 정렬할 요소 개수 → main에서 nx(=6)를 넘겨줌
     */
    public static void Usort(int[] array, int length){
        for (int i = 0; i < length; i++) {
            // j는 0부터 length - i - 2 까지 이동하며 j와 j+1 비교
            for (int j = 0; j < length - i - 1; j++) {
                // 왼쪽이 오른쪽보다 크면 교환 → 오름차순
                if (array[j] > array[j + 1]) {
                    swap(array, j, j + 1);
                }
            }
            // ★ i회전이 끝날 때마다 가장 큰 값 하나가 맨 뒤로 확정된다.
            // 예시(초기 item = [5,3,8,1,2,7]):
            // i=0 끝 → [3,5,1,2,7,8]  (8이 맨 뒤 확정)
            // i=1 끝 → [3,1,2,5,7,8]  (7이 뒤에서 두 번째 확정)
            // i=2 끝 → [1,2,3,5,7,8]  (3까지 제자리를 찾아감)
            // i>=3 → 이미 정렬 완료 상태 유지
        }
    }

    public static void main(String[] args) {
        int[] item = new int[] { 5, 3, 8, 1, 2, 7 };
        int nx = 6;   // 배열 길이 (요소 6개)

        // (2) 자리에 들어갈 것: nx → Usort는 정렬할 '길이'를 필요로 함
        Usort(item, nx);

        // 최종 결과 출력: 1 2 3 5 7 8
        for (int data : item) {
            System.out.print(data + " ");
        }
    }
}

/*
[정답 도출 과정 상세 주석]

초기: [5, 3, 8, 1, 2, 7]

i=0 회전 (가장 큰 값이 맨 뒤로 감)
 j=0: 5>3 → swap  → [3,5,8,1,2,7]
 j=1: 5>8 → X     → [3,5,8,1,2,7]
 j=2: 8>1 → swap  → [3,5,1,8,2,7]
 j=3: 8>2 → swap  → [3,5,1,2,8,7]
 j=4: 8>7 → swap  → [3,5,1,2,7,8]   ← 8 확정(맨 뒤)

i=1 회전 (그 다음 큰 값이 뒤에서 두 번째로 감)
 j=0: 3>5 → X     → [3,5,1,2,7,8]
 j=1: 5>1 → swap  → [3,1,5,2,7,8]
 j=2: 5>2 → swap  → [3,1,2,5,7,8]
 j=3: 5>7 → X     → [3,1,2,5,7,8]   ← 7 확정(뒤에서 2번째)

i=2 회전
 j=0: 3>1 → swap  → [1,3,2,5,7,8]
 j=1: 3>2 → swap  → [1,2,3,5,7,8]
 j=2: 3>5 → X     → [1,2,3,5,7,8]   ← 3 위치 확정

i=3,4,5 회전 → 이미 정렬 완료 상태 유지

최종: [1, 2, 3, 5, 7, 8]

(1) swap의 세 번째 대입 대상은 'idx2'
(2) Usort의 길이는 'nx'
*/
