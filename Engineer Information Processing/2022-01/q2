def exam(num1, num2=2):           # 함수 정의: num1은 필수 인자, num2는 기본값 2를 가짐
    print('a=', num1, 'b=', num2) # num1과 num2 값을 출력

exam(20)                          # 함수 호출 시 num1=20으로 전달, num2는 전달되지 않아 기본값 2 사용

# 실행 순서 요약:
# 1️⃣ exam(20) 호출
#     → num1 = 20
#     → num2 = 2 (기본값)
# 2️⃣ print문 실행
#     → 'a=', 20, 'b=', 2 출력

# 최종 출력 결과:
# a= 20 b= 2
