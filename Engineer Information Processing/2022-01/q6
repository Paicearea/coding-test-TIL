#include <stdio.h> 

// -------------------------
// isPrime: 어떤 정수가 '소수(1과 자기 자신으로만 나누어지는 수)'인지 검사
// 반환: 1(소수), 0(소수 아님)
// -------------------------
int isPrime(int number) { 
  int i; 

  // (예외 간단 처리: 2 미만은 소수가 아님 — 본 문제에선 2 이상만 검사하므로 생략 가능)
  if (number < 2) return 0;

  // 2부터 number-1까지 나눠보며 나누어 떨어지는지 확인
  for (i = 2; i < number; i++) { 
    if (number % i == 0)       // i로 나누어 떨어지면
      return 0;                // 소수가 아님 → 0 반환
  }
  return 1;                    // 어떤 수로도 나누어지지 않으면 소수 → 1 반환
} 
 
int main(void) { 
  int number = 13195;   // 가장 큰 소인수를 구할 대상 수
  int max_div = 0;      // 지금까지 찾은 "가장 큰 소인수"를 저장
  int i;                // 반복 변수

  // 2부터 number-1까지 모든 i를 검사
  for (i = 2; i < number; i++) {

    // (1) i가 소수인지 확인
    // (2) i가 number의 약수(= 나누어 떨어짐)인지 확인
    // 두 조건을 모두 만족하면 i는 "소인수"
    if (isPrime(i) == 1 && number % i == 0) {
      max_div = i;  // 더 큰 소인수를 발견할 때마다 덮어씀
      /*
        ⭐ 진행 개념(설명용):

        13195를 나누는 소수 i를 작은 것부터 차례로 만나게 됨.
        대표적인 소인수는 5, 7, 13, 29 이고 모두 소수.

        검사 흐름(요점):
        - i=5  : isPrime(5)=1, 13195 % 5 == 0  → max_div = 5
        - i=7  : isPrime(7)=1, 13195 % 7 == 0  → max_div = 7  (업데이트)
        - i=13 : isPrime(13)=1, 13195 % 13==0 → max_div = 13 (업데이트)
        - i=29 : isPrime(29)=1, 13195 % 29==0 → max_div = 29 (업데이트)
        - 이후 더 큰 소수들로는 13195가 나누어지지 않으므로 max_div는 29로 유지

        즉, 반복문이 끝나면 max_div에는 "가장 마지막(=가장 큰) 소인수" 29가 남음.
      */
    }
  }

  // 반복 종료 시점: max_div에는 가장 큰 소인수 저장됨 → 29
  printf("%d", max_div);  // ⭐ 최종 출력: 29

  return 0; 
}
