class A {
  int a;
  int b;
}

public class Main {

  static void func1(A m) {
    m.a *= 10;           // m.a = m.a * 10
  }

  static void func2(A m) {
    m.a += m.b;          // m.a = m.a + m.b
  }

  public static void main(String args[]) {

    A m = new A();        // 객체 생성 (m.a=0, m.b=0)

    m.a = 100;            // (1) m.a = 100
    func1(m);             // (2) func1 호출 → m.a = 100 * 10 = 1000

    m.b = m.a;            // (3) m.b = m.a → m.b = 1000

    func2(m);             // (4) func2 호출 → m.a = m.a + m.b = 1000 + 1000 = 2000

    System.out.printf("%d", m.a);  // (5) m.a 출력 → 2000
  }
}
