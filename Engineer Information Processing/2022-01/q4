#include <stdio.h>

// func: 재귀함수를 이용해 a! (a 팩토리얼)을 계산하는 함수
int func(int a) {
    if (a <= 1) return 1;      // (1) a가 1 이하이면 1 반환 (재귀 종료 조건)
    return a * func(a - 1);    // (2) 그렇지 않으면 a × func(a-1)
}

int main() {
    int a;
    scanf("%d", &a);           // (3) 사용자 입력 받음 → 여기서 a = 5

    printf("%d", func(a));     // (4) func(5)의 결과 출력
}

; func(5)
; = 5 * func(4)
; = 5 * (4 * func(3))
; = 5 * (4 * (3 * func(2)))
; = 5 * (4 * (3 * (2 * func(1))))
; = 5 * (4 * (3 * (2 * 1)))     ← func(1)은 1을 반환
; = 5 * 4 * 3 * 2 * 1
; = 120
