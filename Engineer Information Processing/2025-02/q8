lst = [1, 2, 3]
dst = {i : i * 2 for i in lst}
# dst = {1:2, 2:4, 3:6}

s = set(dst.values())
# s = {2, 4, 6}

lst[0] = 99
# lst = [99, 2, 3]   ← dst에는 영향 없음 (복사된 값으로 만들었기 때문)

dst[2] = 7
# dst = {1:2, 2:7, 3:6}

s.add(99)
# s = {2, 4, 6, 99}

print(len(s & set(dst.values())))
# set(dst.values()) = {2, 7, 6}
# s ∩ set(dst.values()) = {2, 6}
# len(...) = 2
# 예상 출력: 2