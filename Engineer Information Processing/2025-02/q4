#include <stdio.h>
#define SIZE 3    // 큐의 크기

typedef struct {
    int a[SIZE];  // 큐 배열
    int front;    // 꺼낼 위치 (dequeue 위치)
    int rear;     // 넣을 위치 (enqueue 위치)
} Queue;

void enq(Queue* q, int val){
    q->a[q->rear] = val;                  // rear 위치에 값 저장
    q->rear = (q->rear + 1) % SIZE;       // rear 한 칸 이동 (원형 처리)
}

int deq(Queue* q) {
    int val = q->a[q->front];             // front 위치의 값 꺼냄
    q->front = (q->front + 1) % SIZE;     // front 한 칸 이동 (원형 처리)
    return val;
}

int main() {
    Queue q = {{0}, 0, 0};  // 초기화: a = {0,0,0}, front=0, rear=0

    // 동작 순서
    enq(&q,1);  // [1,0,0], front=0, rear=1
    enq(&q,2);  // [1,2,0], front=0, rear=2
    deq(&q);    // 1 꺼냄 → front=1, rear=2
                 // 큐 상태 [?,2,0]
    enq(&q,3);  // [?,2,3], front=1, rear=0 (원형)

    int first = deq(&q);   // 2 꺼냄 → front=2, rear=0
    int second = deq(&q);  // 3 꺼냄 → front=0, rear=0

    printf("%d 그리고 %d", first, second);

    return 0;
}
