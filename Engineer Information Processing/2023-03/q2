#include <stdio.h>

// ✅ test 함수: 숫자 n이 완전수인지 확인하는 함수
int test(int n) {
    int i, sum = 0;

    // ① n의 약수(i)를 모두 더함 (단, 자기 자신 n은 제외 → n/2까지만)
    for (i = 1; i <= n / 2; i++) {
        if (n % i == 0)   // i가 n의 약수이면
            sum += i;      // sum에 더함
    }

    // ② 약수의 합(sum)이 자기 자신과 같다면 → 완전수
    if (n == sum)
        return 1;  // 완전수일 때 true(1) 반환

    return 0;      // 완전수가 아니면 false(0) 반환
}

int main() {
    int i, sum = 0;

    // ③ 2부터 100까지 반복하면서 완전수 찾기
    for (i = 2; i <= 100; i++) {
        if (test(i))      // test(i)가 1이면 (즉, 완전수이면)
            sum += i;     // 그 수를 합산
    }

    // ④ 결과 출력
    printf("%d ", sum);

    return 0;
}

