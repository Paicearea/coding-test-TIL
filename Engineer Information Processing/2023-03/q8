print("파이썬 입출력에 대한 문제입니다.")

# input() → 한 줄 입력받기 (기본적으로 문자열로 입력됨)
# 예: 3 5  (사용자가 공백으로 구분 입력)
# split() → 공백 기준으로 나누어 리스트로 반환
num1, num2 = input().split()   # ✅ 빈칸 정답: split()

# 문자열을 정수형으로 변환
num1 = int(num1)
num2 = int(num2)

# 두 수 출력 (쉼표 사용 시 공백으로 구분되어 출력됨)
print(num1, num2)

# 덧셈 연산
num3 = num1 + num2

# ⚠️ 문자열 + 숫자는 바로 더할 수 없음 → str()로 형변환 필요
print(str(num1) + " + " + str(num2) + " = " + str(num3))
