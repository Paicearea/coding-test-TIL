#include <stdio.h>   // printf 사용을 위한 헤더

int main() {
    char* p = "KOREA";  
    // 문자열 상수 "KOREA"를 가리키는 포인터 p
    // 메모리 구조:
    // p → ['K']['O']['R']['E']['A']['\0']

    // ① 전체 문자열 출력
    printf("%s\n", p);    
    // %s : 문자열 출력
    // p는 문자열 "KOREA"의 시작 주소이므로
    // 출력 → "KOREA"

    // ② p+1 은 문자열의 두 번째 문자 'O'를 가리킴
    printf("%s\n", p+1);  
    // 출력 → "OREA"

    // ③ *p : p가 가리키는 첫 번째 문자
    printf("%c\n", *p);   
    // *p = 'K'
    // 출력 → K

    // ④ *(p+3) : p에서 3칸 뒤 → 'E'
    printf("%c\n", *(p+3));  
    // 출력 → E

    // ⑤ *p + 4 : 'K'의 아스키 코드(75)에 4를 더함 → 79 → 'O'
    printf("%c\n", *p + 4);  
    // 출력 → O

    return 0;
}
