class Parent {
    // ✅ Parent의 compute(): 피보나치 형태
    int compute(int num) {
        if (num <= 1)
            return num;
        return compute(num - 1) + compute(num - 2);
    }
}

class Child extends Parent {
    // ✅ Child의 compute(): (num-3)으로 재귀
    int compute(int num) {
        if (num <= 1)
            return num;

        // ⚠️ 오버라이딩된 메서드이므로
        // Parent obj = new Child(); 일 때에도
        // 호출되는 것은 Child의 compute()이다!
        return compute(num - 1) + compute(num - 3);
    }
}

public class main {
    public static void main(String args[]) {
        Parent obj = new Child();   // 다형성: Parent 타입으로 Child 객체 참조
        System.out.print(obj.compute(7));  // Child의 compute(7) 실행
    }
}

